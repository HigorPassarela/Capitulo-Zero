# Environment variables read by application.yaml. Set them in the IDE run configuration.
# HS256 JWT secret (at least 32 bytes). Required.
CZ_JWT_SECRET=local-development-secret-capitulo-zero-32-bytes-or-more
# CORS origins, comma separated. Empty = no browser origin allowed.
CZ_CORS_ORIGINS=http://localhost:5173
# Publishes /v3/api-docs and /swagger-ui.html. Disabled by default.
CZ_API_DOCS_ENABLED=true
# Used from the payments change on.
CZ_PSP_WEBHOOK_SECRET=
# Used from the identity change on.
CZ_ADMIN_EMAIL=
CZ_ADMIN_PASSWORD=
